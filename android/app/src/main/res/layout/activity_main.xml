<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="20dp" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textAppearance="?android:attr/textAppearanceLarge" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/intro" />
        <TextView android:id="@+id/folder_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/folder_heading"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <!-- Natural height: the folder only changes through the user's own choice. -->
        <TextView android:id="@+id/folder" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
        <LinearLayout style="?android:attr/buttonBarStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/choose_folder" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/choose_folder" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/open_folder" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/open_folder" />
        </LinearLayout>
        <TextView android:id="@+id/server_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/server_heading"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <!-- Start and Stop sit above the changing status text, so they never move when the state changes. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button style="@android:style/Widget.Material.Button.Colored" android:id="@+id/start"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="8dp" android:minHeight="56dp" android:text="@string/start" />
            <Button style="@android:style/Widget.Material.Button" android:id="@+id/stop"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:minHeight="56dp" android:text="@string/stop" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/address_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/address_heading"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <TextView android:id="@+id/address" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:fontFamily="monospace" android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary" android:textIsSelectable="true" />
        <LinearLayout style="?android:attr/buttonBarStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/copy" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/copy"
                android:contentDescription="@string/copy_address" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/share" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/share"
                android:contentDescription="@string/share_address" />
        </LinearLayout>
        <TextView android:id="@+id/activity_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/activity_heading"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <TextView android:id="@+id/activity_preview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"
            android:textAppearance="?android:attr/textAppearanceSmall" />
        <Button android:id="@+id/open_logs" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="56dp" android:text="@string/open_logs" />
        <CheckBox android:id="@+id/keep_screen_on" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="48dp" android:text="@string/keep_screen_on" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/keep_screen_on_help" />
        <CheckBox android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="48dp" android:text="@string/privacy_mode" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/privacy_help" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:text="@string/trust_note" />
        <Button android:id="@+id/licenses" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/licenses" />
    </LinearLayout>
</ScrollView>
